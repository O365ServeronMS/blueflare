NODE_ENV=production
PORT=3200
PUBLIC_BASE_URL=https://img.bluesia.net

# ---------------------------------------------------------------------------
# TMDB (Hero Trending + artwork)
# ---------------------------------------------------------------------------
# Master switch. false disables the hero-trending refresh, TMDB image sync,
# and the TMDB title-search fallback below in one flag, even if TMDB_API_KEY
# is set. Effectively also off whenever TMDB_API_KEY is empty.
TMDB_ENABLED=true
# Server-only TMDB v3 key used by the hourly Hero Trending refresh.
TMDB_API_KEY=replace-with-tmdb-v3-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_TRENDING_LANGUAGE=vi-VN
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_REQUEST_TIMEOUT_MS=5000
HERO_TRENDING_LIMIT=24
HERO_TRENDING_CANDIDATE_PAGES=3
HERO_TRENDING_REFRESH_MS=3600000

# Verifies artwork for rows that already carry a tmdb_id.
TMDB_IMAGE_SYNC_ENABLED=true
TMDB_IMAGE_SYNC_LIMIT=32
TMDB_IMAGE_SYNC_CONCURRENCY=2
TMDB_IMAGE_RETRY_MS=21600000

# Title-search fallback for rows with no provider artwork and no tmdb_id.
# Only an unambiguous exact title match is accepted, so most candidates are
# expected to be declined and retried slowly.
TMDB_IMAGE_FALLBACK_ENABLED=true
TMDB_IMAGE_FALLBACK_LIMIT=16
TMDB_IMAGE_FALLBACK_CONCURRENCY=2
TMDB_IMAGE_FALLBACK_RETRY_MS=604800000

POSTGRES_DB=blueflare
POSTGRES_USER=blueflare
POSTGRES_PASSWORD=replace-with-a-long-random-password
DATABASE_URL=postgres://blueflare:replace-with-a-long-random-password@postgres:5432/blueflare
REDIS_URL=redis://valkey:6379

# PostgreSQL 18+ uses the parent mount and a major-version-specific PGDATA.
# postgres-data is a fresh restore-based rollback target for PostgreSQL 17.
POSTGRES_IMAGE=postgres:18.6-alpine
POSTGRES_VOLUME=postgres18-data
POSTGRES_MOUNT=/var/lib/postgresql
VALKEY_IMAGE=valkey/valkey:9.1.1-alpine
VALKEY_MAXMEMORY=512mb

IMAGE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
IMAGE_CACHE_DIR=/data/images
IMAGE_CACHE_HOST_DIR=/opt/docker/data/blueflare/images
IMAGE_ALLOWED_HOSTS=phim.nguonc.com,phimimg.com,phimapi.com,image.tmdb.org

# ---------------------------------------------------------------------------
# Head sync — scans the newest N pages of each provider every SYNC_INTERVAL_MS
# ---------------------------------------------------------------------------
NGUONC_BASE_URL=https://phim.nguonc.com
KKPHIM_BASE_URL=https://phimapi.com
SYNC_ENABLED=true
# Comma-separated subset of: nguonc,kkphim. Drop one to pause it without
# touching the other.
SYNC_PROVIDERS=nguonc,kkphim
SYNC_PAGES_PER_RUN=3
SYNC_CONCURRENCY=4
SYNC_INTERVAL_MS=900000

# ---------------------------------------------------------------------------
# Backfill — walks older pages behind a persisted per-provider checkpoint.
# Runs on its own cadence (BACKFILL_INTERVAL_MS), independent of head sync.
# ---------------------------------------------------------------------------
BACKFILL_ENABLED=true
BACKFILL_PROVIDERS=nguonc,kkphim
# Leave 0 to start immediately after the pages covered by SYNC_PAGES_PER_RUN.
BACKFILL_START_PAGE=0
# Leave 0 to walk until the provider reports no more pages.
BACKFILL_END_PAGE=0
# Pages fetched per backfill pass.
BACKFILL_PAGES_PER_RUN=19
# Minimum time between backfill passes. Independent of SYNC_INTERVAL_MS so
# backfill can run less often than head sync (e.g. once an hour vs every 15m).
BACKFILL_INTERVAL_MS=900000
# Pause between pages within one backfill pass, on top of the per-provider
# request pacing below. 0 = no extra pause.
BACKFILL_COOLDOWN_MS=0

REQUEST_TIMEOUT_MS=15000
# Per-provider request pacing. KKPhim is rate-limited; retain the 1 request/sec cap.
NGUONC_REQUEST_MIN_INTERVAL_MS=0
KKPHIM_REQUEST_MIN_INTERVAL_MS=1000

RESPONSE_CACHE_TTL_SECONDS=300
RESPONSE_CACHE_STALE_SECONDS=86400
CDN_TTL_SECONDS=300
ALLOWED_ORIGINS=https://film.bluesia.net,https://phim.bluesia.net

# ---------------------------------------------------------------------------
# Cache/tag invalidation fan-out after a sync cycle changes canonical rows.
# ---------------------------------------------------------------------------
INVALIDATE_LIST_TYPES=phim-moi-cap-nhat,phim-le,phim-bo,hoat-hinh,tv-shows
INVALIDATE_PAGE_DEPTH=3
REVALIDATE_TIMEOUT_MS=5000

# Shared secret for targeted Next.js render-cache invalidation. Required for
# the worker to ever push updates to the frontend — an empty value silently
# disables revalidation with no error.
FRONTEND_REVALIDATE_SECRET=replace-with-a-long-random-secret

FRONTEND_REVALIDATE_URL=http://frontend:3000/api/internal/revalidate

# Optional token for the non-cacheable /api/metrics endpoint.
METRICS_TOKEN=replace-with-a-long-random-metrics-token

# ---------------------------------------------------------------------------
# Frontend feature flags — read at container start by Server Components.
# Flip and `docker compose up -d frontend` to ship; no image rebuild needed.
# ---------------------------------------------------------------------------
FEATURE_HERO_SLIDER=true
FEATURE_SEARCH_SUGGEST=true
FEATURE_LOCAL_LIBRARY=true
# Default items shown per home row (the "Phim mới cập nhật" row always shows 24).
HOME_SECTION_LIMIT=16

# =============================================================================
# FilmBluesia stack environment - the single list of every key the stack reads.
#
# Purpose: copy to /opt/stacks/blueflare/.env and fill in real values.
#   infra/scripts/apply-env.sh (deploy/apply-env.sh in the stack dir) fails the
#   deploy if the stack .env lacks ANY key listed in this file. Add a new key here
#   AND to the stack .env.
#
# Legend (comment lines directly above a key):
#   # SECRET:   credential, never commit a real value (this file holds placeholders).
#   # REQUIRED: apply-env.sh also rejects an empty value or a `replace-with-*`
#               placeholder for it.
# Section headers carry [reads: ...] = which service consumes the keys below it
# (api, worker, frontend, compose = substituted in infra/compose.yml, backup).
#
# How to read: one `KEY=default` per line, comments above it explain it. Defaults
# shown are the production defaults. Durations are ms unless the name says SECONDS.
# =============================================================================

# === 1. Runtime / API basics ===
# [reads: api, worker] no secrets
NODE_ENV=production
PORT=3200
# Public origin of the API/image host; used when building absolute image URLs.
PUBLIC_BASE_URL=https://img.bluesia.net

# === 2. PostgreSQL, Valkey and image-cache paths (compose-level) ===
# [reads: compose, api, worker] contains SECRET values
POSTGRES_DB=blueflare
POSTGRES_USER=blueflare
# SECRET:
# REQUIRED:
POSTGRES_PASSWORD=replace-with-a-long-random-password
# SECRET: embeds the PostgreSQL password; keep it consistent with POSTGRES_PASSWORD.
DATABASE_URL=postgres://blueflare:replace-with-a-long-random-password@postgres:5432/blueflare
REDIS_URL=redis://valkey:6379
# PostgreSQL 18+ uses the parent mount and a major-version-specific PGDATA.
# POSTGRES_VOLUME is the physical Docker volume name. Restore into a new name
# for a major or base-OS change, retaining this one for rollback.
POSTGRES_IMAGE=postgres:18.6-trixie
POSTGRES_VOLUME=blueflare_postgres-data
POSTGRES_MOUNT=/var/lib/postgresql
VALKEY_IMAGE=valkey/valkey:9.2-trixie
VALKEY_MAXMEMORY=512mb
# In-container image cache dir (api is its only writer) and its host bind mount.
IMAGE_CACHE_DIR=/data/images
IMAGE_CACHE_HOST_DIR=/opt/stacks/blueflare/data/images

# === 3. Provider sync: head sync, backfill, sweep, stale sources, duplicates ===
# [reads: worker] no secrets
NGUONC_BASE_URL=https://phim.nguonc.com
KKPHIM_BASE_URL=https://phimapi.com
REQUEST_TIMEOUT_MS=15000
# Per-provider request pacing. KKPhim is rate-limited; retain the 1 request/sec cap.
NGUONC_REQUEST_MIN_INTERVAL_MS=0
KKPHIM_REQUEST_MIN_INTERVAL_MS=1000

# -- Head sync: scans the newest N pages of each provider every SYNC_INTERVAL_MS.
# Off = no head sync cycle.
SYNC_ENABLED=true
# Comma-separated subset of: nguonc,kkphim. Drop one to pause it without
# touching the other.
SYNC_PROVIDERS=nguonc,kkphim
SYNC_PAGES_PER_RUN=3
SYNC_CONCURRENCY=4
SYNC_INTERVAL_MS=900000

# -- Backfill: walks older pages behind a persisted per-provider checkpoint.
# Runs on its own cadence (BACKFILL_INTERVAL_MS), independent of head sync. Off = no backfill.
BACKFILL_ENABLED=true
BACKFILL_PROVIDERS=nguonc,kkphim
# 0 = start right after the pages covered by SYNC_PAGES_PER_RUN.
BACKFILL_START_PAGE=0
# 0 = walk until the provider reports no more pages.
BACKFILL_END_PAGE=0
# Pages fetched per backfill pass.
BACKFILL_PAGES_PER_RUN=19
# Minimum time between passes; may be slower than head sync (e.g. hourly vs 15 min).
BACKFILL_INTERVAL_MS=900000
# Extra pause between pages in one pass, on top of per-provider pacing. 0 = none.
BACKFILL_COOLDOWN_MS=0
# A finished backfill walk restarts after this many days. 0 = never restart.
SWEEP_CYCLE_DAYS=14

# -- Stale-source lane: re-fetch detail for sources not refreshed for STALE_SOURCE_DAYS,
# at most STALE_SOURCE_BATCH per cycle. Modes: off | dry-run | apply.
# apply marks a source unavailable only after two 404s at least 7 days apart
# (other errors never count). dry-run only logs.
STALE_SOURCE_DAYS=14
STALE_SOURCE_BATCH=150
STALE_SOURCE_MODE=dry-run

# -- Duplicate merge: fold a NguonC-only title into the KKPhim row of the same work.
# Modes: off | dry-run | apply. dry-run logs what apply would merge; apply merges
# at most MERGE_BATCH_LIMIT per sync cycle.
MERGE_DUPLICATES_MODE=dry-run
MERGE_BATCH_LIMIT=50
# The worker logs `[worker] ALERT duplicate merge ...` when more pairs than this wait after a pass.
MERGE_ALERT_PENDING=200

# === 4. TMDB ===
# [reads: worker] contains a SECRET
# Master switch. false disables hero trending, image sync, title-search fallback and
# id lookup in one flag, even if TMDB_API_KEY is set. Also off whenever the key is empty.
TMDB_ENABLED=true
# SECRET: server-only TMDB v3 key. Not regenerable by bootstrap-vps.sh; keep a copy off the VPS.
TMDB_API_KEY=replace-with-tmdb-v3-api-key
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_TRENDING_LANGUAGE=vi-VN
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p
TMDB_REQUEST_TIMEOUT_MS=5000

# -- Hero trending: hourly refresh of the home hero list.
HERO_TRENDING_LIMIT=24
HERO_TRENDING_CANDIDATE_PAGES=3
HERO_TRENDING_MAX_CANDIDATE_PAGES=8
HERO_TRENDING_REFRESH_MS=3600000

# -- Image sync: verifies artwork for rows that already carry a tmdb_id. Off = skipped.
TMDB_IMAGE_SYNC_ENABLED=true
TMDB_IMAGE_SYNC_LIMIT=32
TMDB_IMAGE_SYNC_CONCURRENCY=2
TMDB_IMAGE_RETRY_MS=21600000

# -- Image fallback: title search for rows with no provider artwork and no tmdb_id.
# Only an unambiguous exact title match is accepted, so most candidates are
# declined and retried slowly. Off = skipped.
TMDB_IMAGE_FALLBACK_ENABLED=true
TMDB_IMAGE_FALLBACK_LIMIT=16
TMDB_IMAGE_FALLBACK_CONCURRENCY=2
TMDB_IMAGE_FALLBACK_RETRY_MS=604800000

# -- Id lookup: guess a TMDB id from the title for rows with neither tmdb_id nor imdb_id,
# so MDBList can look up a Rotten Tomatoes score. The guess is stored in
# tmdb_lookup_id, never in tmdb_id: a wrong match may cost one row a wrong score
# but must never merge two unrelated titles. Off = no guesses.
TMDB_LOOKUP_ENABLED=true
# Rows per sync cycle. TMDB has no hard daily cap, so this is set for throughput.
TMDB_LOOKUP_LIMIT=500
TMDB_LOOKUP_CONCURRENCY=4
# An unresolved row is retried after 30 days; a match is never redone.
TMDB_LOOKUP_RETRY_MS=2592000000

# -- Cast-verified identity for titles the provider gave no tmdb_id (stored in
# tmdb_match_*; feeds credits and MDBList lookup fixes, never touches artwork).
# Off by default (~7 TMDB calls per checked title).
TMDB_MATCH_ENABLED=false
TMDB_MATCH_LIMIT=60
TMDB_MATCH_CONCURRENCY=2
# 'none'/'unverifiable' verdicts are re-checked after 30 days; errors after 6 hours.
TMDB_MATCH_REFRESH_MS=2592000000
TMDB_MATCH_RETRY_MS=21600000
# Primary-country slugs skipped on purpose, comma separated.
TMDB_MATCH_SKIP_COUNTRIES=trung-quoc,hong-kong,nhat-ban,han-quoc,thai-lan

# -- AI ranking of TMDB candidates for the same titles (phase after the cast check). Gemini
# only ranks real TMDB candidates the worker fetched; it never supplies an id itself.
# Off by default. [reads: worker] contains SECRET values
# SECRET: its own keys, comma-separated, ideally from different Google projects. This pass
# NEVER falls back to GEMINI_API_KEYS (review translation): empty keys = the AI pass is off.
TMDB_MATCH_AI_ENABLED=false
TMDB_MATCH_GEMINI_API_KEYS=
# Ordered `id[:rpm]`, same rotation and failure handling as GEMINI_MODELS (state is separate).
TMDB_MATCH_GEMINI_MODELS=gemini-3.8-flash:5,gemini-3.7-flash:5,gemini-3.6-flash:5
# Titles ranked per Gemini request.
TMDB_MATCH_GEMINI_BATCH=10
TMDB_MATCH_GEMINI_TIMEOUT_MS=30000
# How long a rejected key or unknown model stays off.
TMDB_MATCH_GEMINI_COOLDOWN_MS=21600000

# -- Recommendations: recommendation/similar id lists for the "Có thể bạn cũng thích" rail.
# Worker fetches; the API reads them from PostgreSQL. Rows per cycle are distinct
# TMDB identities, two TMDB calls each. Off = rail not refreshed.
TMDB_RECOMMENDATIONS_ENABLED=true
TMDB_RECOMMENDATIONS_LIMIT=300
TMDB_RECOMMENDATIONS_CONCURRENCY=3
# A fetched list is refreshed after 14 days; a failed fetch is retried after 6 hours.
TMDB_RECOMMENDATIONS_REFRESH_MS=1209600000
TMDB_RECOMMENDATIONS_RETRY_MS=21600000

# -- Credits: cast/director behind /person/<slug> and the detail-page cast strip.
# Worker fetches; the API reads from PostgreSQL. One TMDB call per distinct verified
# TMDB identity per cycle. Off = credits not refreshed.
TMDB_CREDITS_ENABLED=true
TMDB_CREDITS_LIMIT=300
TMDB_CREDITS_CONCURRENCY=3
# Top N billed cast per title, plus every crew member with job='Director'.
TMDB_CREDITS_CAST_LIMIT=12
# A fetched list is refreshed after 90 days; a failed fetch after 6 hours.
TMDB_CREDITS_REFRESH_MS=7776000000
TMDB_CREDITS_RETRY_MS=21600000

# -- Reviews: TMDB user reviews on the detail page. Worker only, verified TMDB
# identities only. Up to 2 TMDB pages per title; reviews under 40 chars are
# dropped; bodies are stored as plain text truncated to 4000 chars. A fetched
# title is refreshed after 7 days; a failed fetch after 6 hours. Off = no refresh.
TMDB_REVIEWS_ENABLED=true
TMDB_REVIEWS_LIMIT=200
TMDB_REVIEWS_CONCURRENCY=3
TMDB_REVIEWS_REFRESH_MS=604800000
TMDB_REVIEWS_RETRY_MS=21600000
TMDB_REVIEWS_MAX_PER_MOVIE=40

# === 5. Review translation (English -> Vietnamese) ===
# [reads: worker] contains a SECRET
# Worker only, sequential, fail-open to English. Runs right after the reviews pass.
# Off = reviews stay English.
TRANSLATE_ENABLED=true
# Ordered comma-separated chain of: gemini, google-gtx. The first usable provider
# translates; when it is blocked it cools down and the next continues the same review.
# Default `gemini`. `gemini,google-gtx` adds the unofficial gtx endpoint as fallback.
TRANSLATE_PROVIDER=gemini
TRANSLATE_REVIEWS_PER_CYCLE=150
# A blocked answer, or this many consecutive errors, pauses the pass for TRANSLATE_COOLDOWN_MS.
TRANSLATE_MAX_CONSECUTIVE_ERRORS=5
TRANSLATE_COOLDOWN_MS=3600000
# gtx only: spacing between calls and per-call timeout.
TRANSLATE_DELAY_MS=1000
TRANSLATE_TIMEOUT_MS=10000

# -- Gemini provider (Google AI Studio free tier). Only public TMDB review text is
# sent; the key goes in a request header.
# SECRET: empty disables this provider (skipped, nothing fails; no translation
# happens unless google-gtx is also in TRANSLATE_PROVIDER).
# SECRET: one or more keys, comma-separated (trimmed; blanks and duplicates dropped).
# Quota is per Google project, so each key must come from a different Google
# account/project; keys of the same project share quota.
# Rotation is best model first: for each model the keys are tried in order, and the next
# model is used only when no key can serve the current one. Spacing/RPM/daily state is per
# (key, model). 401/403/invalid-key disables only that key for GEMINI_COOLDOWN_MS.
GEMINI_API_KEYS=
# Ordered `id[:rpm]` rotation, best first; each model has its own free quota (rpm default 5).
# A request uses the first model that is not cooling down and whose spacing
# (60s/rpm + margin; gemma also its 16K TPM) has elapsed. Failure handling:
#   per-minute 429 -> that model cools for the retryDelay
#   daily-quota 429 -> parked until 00:00 America/Los_Angeles
#   404 unknown model -> off for GEMINI_COOLDOWN_MS
#   (429 states are per key+model; a 404 model is off for every key)
#   401/403 -> that key off (all its models) for GEMINI_COOLDOWN_MS
# Every key+model pair parked (or every key rejected) = provider blocked, next provider in the chain takes over.
# Each review records translate_provider as gemini:<model id>.
# Ids are API ids from ai.google.dev (gemini-3-flash is gemini-3-flash-preview).
GEMINI_MODELS=gemini-3.5-flash-lite:15,gemini-3.1-flash-lite:15,gemini-3.8-flash:5,gemini-3.7-flash:5,gemini-3.6-flash:5,gemini-3.5-flash:5,gemini-2.5-flash-lite:10,gemini-3-flash-preview:5,gemini-2.5-flash:5,gemma-4-31b-it:30,gemma-4-26b-a4b-it:30
GEMINI_TIMEOUT_MS=30000
# Optional minimum spacing floor for every model. 0 = use each model's rpm.
GEMINI_DELAY_MS=0
GEMINI_COOLDOWN_MS=21600000

# === 6. MDBList (Rotten Tomatoes critic + audience percentages) ===
# [reads: worker] contains SECRET values
# Server-only background sync. Off (and effectively off whenever no key is set).
MDBLIST_ENABLED=false
# SECRET: primary key, tried first. Not regenerable by bootstrap-vps.sh; keep a copy off the VPS.
MDBLIST_API_KEY=replace-with-mdblist-api-key
# SECRET: comma-separated fallback keys, consumed in order. Daily budgets are tracked
# per key by a short SHA-256 id, never by storing the credential in PostgreSQL.
MDBLIST_API_KEYS=
MDBLIST_BASE_URL=https://api.mdblist.com
MDBLIST_REQUEST_TIMEOUT_MS=5000

# Spend quota only on the approved visible catalog surfaces.
MDBLIST_RATING_TYPES=trending,phim-le,phim-bo
MDBLIST_PAGE_DEPTH=2
# Free accounts accept 10 ids/request; supporters may raise this up to 100.
MDBLIST_IDS_PER_REQUEST=10

# Per key, per UTC day. The reserve covers manual probes or another process
# using the same key outside this worker.
MDBLIST_DAILY_BUDGET=1000
MDBLIST_BUDGET_RESERVE=50
# Max candidate titles considered per worker cycle, then HTTP concurrency.
MDBLIST_BATCH_LIMIT=60
MDBLIST_CONCURRENCY=2
# Refresh good/missing data slowly; retry transport/API failures after one hour.
# Matched-row refresh by title age: new (<90d) / mid (<2y) / old.
MDBLIST_REFRESH_NEW_MS=604800000
MDBLIST_REFRESH_MS=1209600000
MDBLIST_REFRESH_OLD_MS=3888000000
MDBLIST_MISS_RETRY_MS=7776000000
MDBLIST_ERROR_RETRY_MS=3600000

# -- Full-catalog backfill: walks the movies table by id cursor to score rows the
# demand-driven pass never reaches, one budget-limited slice per cycle, resuming
# from a persisted checkpoint. Idles once the walk completes. Off = no backfill.
MDBLIST_BACKFILL_ENABLED=true
# Candidate rows per pass. Higher fills faster until the daily key budget caps it.
MDBLIST_BACKFILL_BATCH_LIMIT=300
# How often a slice runs. Keep this BELOW SYNC_INTERVAL_MS: the pass runs a few
# seconds into each cycle, so an interval equal to the cycle period makes
# consecutive runs land just under it and skip roughly one cycle in three.
MDBLIST_BACKFILL_INTERVAL_MS=450000
# Set true for one deploy to clear the checkpoint and re-walk from the start,
# then set back to false. The worker resets once per process on startup.
MDBLIST_BACKFILL_RESET=false

# === 7. Images: allowlist, cache, prewarm, sweep, heal, host check ===
# [reads: api, worker] contains a SECRET
# SECRET: LEGACY. Only the legacy HMAC-signed image URL form (?url=&sig=) still
# verifies; nothing emits it now (live URLs are path-only /i/{m,d}/<uuid>.webp).
# REQUIRED: still enforced by apply-env.sh, so keep a real value.
IMAGE_SIGNING_SECRET=replace-with-at-least-32-random-bytes
# Upstream hosts the api may fetch images from (minus hosts dropped by the host check).
IMAGE_ALLOWED_HOSTS=phim.nguonc.com,img.nguonc.com,phimimg.com,phimapi.com,image.tmdb.org
# Hosts treated as dead from the start (worker image heal / host check).
IMAGE_DEAD_HOSTS=phim.nguonc.com
# Where the worker asks the api to build cache entries.
IMAGE_ORIGIN_URL=http://api:3200

# -- Prewarm (worker): asks the api to build the cache entries the home/list
# viewmodels are about to serve, so the first visitor after a sync does not pay the
# upstream fetch + sharp transcode. Off = no prewarm.
IMAGE_PREWARM_ENABLED=true
# 0 = home viewmodel only; each level adds one page of every INVALIDATE_LIST_TYPES list.
IMAGE_PREWARM_PAGE_DEPTH=1
IMAGE_PREWARM_LIMIT=400
IMAGE_PREWARM_CONCURRENCY=4
IMAGE_PREWARM_TIMEOUT_MS=20000
IMAGE_PREWARM_RETRIES=2
IMAGE_PREWARM_RETRY_BASE_MS=500
# Prewarm stands down below this much free disk space (the sweep below does the evicting).
IMAGE_PREWARM_MIN_FREE_BYTES=2147483648

# -- Cache sweep (api, hourly). The cache is disposable (every entry rebuilds from
# image_assets), so it gets a ceiling rather than growing forever.
# 0 = no size eviction; the orphan-.tmp pass still runs.
IMAGE_CACHE_MAX_BYTES=8589934592
# Once over the max, evict least-recently-read entries down to this percent of it.
IMAGE_CACHE_EVICT_TARGET_PERCENT=90
# Never evict an entry read this recently - it may be streaming right now.
IMAGE_CACHE_EVICT_MIN_AGE_MS=3600000
IMAGE_CACHE_TMP_MAX_AGE_MS=3600000
# 0 = sweep disabled entirely.
IMAGE_CACHE_SWEEP_INTERVAL_MS=3600000
IMAGE_CACHE_SWEEP_START_DELAY_MS=60000

# -- Heal (worker): repairs image links broken by provider CDN changes. Off = no heal.
IMAGE_HEAL_ENABLED=true
IMAGE_HEAL_PAGES_PER_RUN=300

# -- Host check (worker): daily liveness check of each IMAGE_ALLOWED_HOSTS host. A host
# whose sampled stored URLs are all gone for IMAGE_HOST_DEAD_AFTER_CHECKS consecutive
# checks is dropped from the effective allowlist and its links are purged
# (cached images are kept). Off = hosts never dropped.
IMAGE_HOST_CHECK_ENABLED=true
IMAGE_HOST_CHECK_INTERVAL_MS=86400000
IMAGE_HOST_CHECK_SAMPLES=8
IMAGE_HOST_DEAD_AFTER_CHECKS=3
IMAGE_HOST_PURGE_LIMIT=5000

# === 8. Cache, CDN, invalidation and CORS ===
# [reads: api, worker] contains a SECRET
RESPONSE_CACHE_TTL_SECONDS=300
RESPONSE_CACHE_STALE_SECONDS=86400
CDN_TTL_SECONDS=300
ALLOWED_ORIGINS=https://phim.bluesia.net

# -- Fan-out after a sync cycle changes canonical rows (Valkey keys + Next render tags).
INVALIDATE_LIST_TYPES=phim-moi-cap-nhat,phim-le,phim-bo,hoat-hinh,tv-shows
INVALIDATE_PAGE_DEPTH=3
REVALIDATE_TIMEOUT_MS=5000
# Worker POSTs here; the frontend balancer replays it to every Next worker.
FRONTEND_REVALIDATE_URL=http://frontend:3000/api/internal/revalidate
# SECRET: shared secret for targeted Next.js render-cache invalidation.
# REQUIRED: empty silently disables revalidation (no error), so the worker would
# never push updates to the frontend.
FRONTEND_REVALIDATE_SECRET=replace-with-a-long-random-secret

# === 9. Account hardening: auth limits, Turnstile, admin ===
# [reads: api, frontend] contains a SECRET
# Code defaults to the AUTH_* values below when unset.
# Max scrypt hashes (login/register) at once. They share the libuv threadpool with
# image I/O, so keep this well below UV_THREADPOOL_SIZE (8).
AUTH_HASH_CONCURRENCY=2
# Hash requests allowed to wait for a slot; beyond this (or after 3 s) the API answers 503 busy.
AUTH_HASH_QUEUE=16
# Global cap on new accounts per hour across all IPs (429 when exceeded).
AUTH_REGISTER_GLOBAL_PER_HOUR=300

# -- Cloudflare Turnstile on signup. Site key is public (the signup page reads it at
# runtime); the secret is read only by api.
TURNSTILE_SITE_KEY=0x4AAAAAAFJ3empfh3F0NReh
# SECRET: empty disables signup verification.
TURNSTILE_SECRET_KEY=

# -- Admin dashboard (/admin): comma-separated emails allowed in; everyone else gets 404.
# Admin accounts cannot be deleted through the dashboard. Empty = nobody is admin.
ADMIN_EMAILS=tunhan9x@gmail.com

# === 10. Frontend feature flags ===
# [reads: frontend] no secrets
# Read at container start by Server Components. Flip and `docker compose up -d frontend`
# to ship; no image rebuild needed.
FEATURE_HERO_SLIDER=true
FEATURE_SEARCH_SUGGEST=true
FEATURE_LOCAL_LIBRARY=true
# Default items shown per home row (the "Phim mới cập nhật" row always shows 24).
HOME_SECTION_LIMIT=16
# Duration (ms) of the <> rail slide animation on home rows. Higher = slower glide.
RAIL_SLIDE_DURATION_MS=300

# === 11. Offsite backup ===
# [reads: backup, compose] contains SECRET values
# Off by default: it needs object-store credentials before it can do anything.
# Target is any S3-compatible store - only endpoint and region change:
#   Cloudflare R2   https://<account_id>.r2.cloudflarestorage.com   region auto
#   Backblaze B2    https://s3.us-west-004.backblazeb2.com          region us-west-004
#   Wasabi          https://s3.eu-central-1.wasabisys.com           region eu-central-1
#   AWS S3          https://s3.eu-central-1.amazonaws.com           region eu-central-1
#   MinIO           https://minio.example.net                       region us-east-1
BACKUP_ENABLED=false
# 86400 = daily. First run happens BACKUP_START_DELAY_SECONDS after boot.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_START_DELAY_SECONDS=300
# Local copies are for a fast restore; the remote ones are the actual backup.
BACKUP_KEEP_LOCAL=3
BACKUP_KEEP_REMOTE=14
BACKUP_HOST_DIR=/opt/stacks/blueflare/backups/postgres
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=auto
BACKUP_S3_BUCKET=blueflare-backups
BACKUP_S3_PREFIX=postgres/
# SECRET:
BACKUP_S3_ACCESS_KEY_ID=
# SECRET:
BACKUP_S3_SECRET_ACCESS_KEY=

# === 12. Observability ===
# [reads: api] contains a SECRET
# SECRET: optional token for the non-cacheable /api/metrics endpoint.
METRICS_TOKEN=replace-with-a-long-random-metrics-token

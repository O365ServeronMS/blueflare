img.bluesia.net {
	encode zstd gzip

	log {
		output file /var/log/caddy/img.bluesia.net.access.log {
			roll_size 20MiB
			roll_keep 10
			roll_keep_for 720h
		}
		format json
	}

	header {
		-Server
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
	}

	reverse_proxy 127.0.0.1:3200
}
